// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────
// SITE CONFIG — Single-row singleton
// Contains all site-wide settings, hero content,
// achievements (JSON), and journey entries (JSON)
// ─────────────────────────────────────────────
model SiteConfig {
  id                 String   @id @default("singleton")
  // Hero
  heroTitle          String   @default("Building Intelligent Systems That Solve Real Problems.")
  heroSubtitle       String   @default("Aspiring AI/ML & Generative AI Engineer focused on building intelligent, multimodal and production-oriented AI systems.")
  availabilityStatus String   @default("Open to opportunities")
  // Personal
  name               String   @default("Kishore R")
  headline           String   @default("Aspiring AI/ML & Generative AI Engineer")
  bio                String   @default("") @db.Text
  location           String   @default("Salem, Tamil Nadu, India")
  contactEmail       String   @default("Kishorehp134@gmail.com")
  phone              String?
  avatarUrl          String?
  resumeUrl          String?
  aboutText          String   @default("") @db.Text
  // SEO
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?   @db.Text
  ogImageUrl         String?
  // Display Options
  heroImageStyle     String?   @default("split")
  // Dynamic JSON sections
  achievements       Json     @default("[]")
  journeyEntries     Json     @default("[]")
  // AI Settings
  geminiApiKey       String?
  geminiModel        String?   @default("gemini-3.1-flash-live-preview")
  // LeetCode (manual + cached)
  leetcodeTotal      Int      @default(380)
  leetcodeEasy       Int      @default(0)
  leetcodeMedium     Int      @default(0)
  leetcodeHard       Int      @default(0)
  leetcodeCache      Json?    // raw submissionCalendar JSON cache
  leetcodeCachedAt   DateTime?
  updatedAt          DateTime @updatedAt

  @@map("site_config")
}

// ─────────────────────────────────────────────
// PROJECT
// ─────────────────────────────────────────────
model Project {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  shortDescription String
  fullDescription  String?   @db.Text
  problem          String?   @db.Text
  solution         String?   @db.Text
  architecture     String?   @db.Text
  technologies     String[]
  githubUrl        String?
  liveUrl          String?
  imageUrl         String?
  metrics          String?
  featured         Boolean   @default(false)
  published        Boolean   @default(true)
  displayOrder     Int       @default(0)
  // GitHub cache — only display-relevant fields
  githubStars      Int?
  githubForks      Int?
  githubLanguage   String?
  githubTopics     String[]
  githubUpdatedAt  DateTime?
  githubCachedAt   DateTime?
  githubSyncEnabled Boolean  @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("projects")
}

// ─────────────────────────────────────────────
// SKILL
// ─────────────────────────────────────────────
model Skill {
  id           String  @id @default(cuid())
  name         String
  category     String  // "AI/ML", "Programming", "Databases", "Tools"
  iconSlug     String?
  displayOrder Int     @default(0)
  published    Boolean @default(true)

  @@map("skills")
}

// ─────────────────────────────────────────────
// CERTIFICATION
// ─────────────────────────────────────────────
model Certification {
  id            String    @id @default(cuid())
  title         String
  issuer        String
  issueDate     DateTime?
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  imageUrl      String?
  description   String?   @db.Text
  published     Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("certifications")
}

// ─────────────────────────────────────────────
// EDUCATION
// ─────────────────────────────────────────────
model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  field        String?
  startDate    DateTime?
  endDate      DateTime?
  score        String?
  description  String?   @db.Text
  displayOrder Int       @default(0)

  @@map("education")
}

// ─────────────────────────────────────────────
// SOCIAL LINK
// ─────────────────────────────────────────────
model SocialLink {
  id           String  @id @default(cuid())
  platform     String  // "GitHub", "LinkedIn", "LeetCode", "Email"
  url          String
  iconSlug     String?
  enabled      Boolean @default(true)
  displayOrder Int     @default(0)

  @@map("social_links")
}

// ─────────────────────────────────────────────
// CONTACT MESSAGE
// soft-deleted via deletedAt — never hard delete
// ─────────────────────────────────────────────
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String    @db.Text
  read      Boolean   @default(false)
  replied   Boolean   @default(false)
  repliedAt DateTime?
  deletedAt DateTime? // soft delete
  createdAt DateTime  @default(now())

  @@map("contact_messages")
}

// ─────────────────────────────────────────────
// BLOG POST
// ─────────────────────────────────────────────
model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  summary      String    @db.Text
  content      String?   @db.Text
  coverImage   String?
  tags         String[]
  readTime     String?   @default("5 min read")
  published    Boolean   @default(true)
  featured     Boolean   @default(false)
  displayOrder Int       @default(0)
  canonicalUrl String?   // External link (Medium, Substack, etc.)
  publishedAt  DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("blog_posts")
}

// ─────────────────────────────────────────────
// SITE VISITOR COUNTER
// Persistent site-wide visitor and visit tracking
// ─────────────────────────────────────────────
model SiteVisitorCounter {
  id            String   @id @default("singleton")
  totalVisits   Int      @default(0)
  lastVisitedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("site_visitor_counter")
}

// ─────────────────────────────────────────────
// AI AGENT — DAILY USAGE BUDGET
// Prisma-backed so limits survive serverless cold starts
// and are shared across all instances.
// ─────────────────────────────────────────────
model AiUsageCounter {
  id          String   @id @default("daily")
  date        String   // "YYYY-MM-DD" — auto-reset key
  sessions    Int      @default(0)
  messages    Int      @default(0)
  toolCalls   Int      @default(0)
  webSearches Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("ai_usage_counter")
}

// ─────────────────────────────────────────────
// AI AGENT — CONVERSATION SESSION
// One record per visitor AI session (voice or chat).
// IP stored as SHA-256 hash — never raw.
// ─────────────────────────────────────────────
model AiConversation {
  id           String      @id @default(cuid())
  sessionId    String      @unique
  mode         String      // "voice" | "chat"
  ipHash       String      // SHA-256(ip) — privacy-safe
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  messageCount Int         @default(0)
  messages     AiMessage[]

  @@map("ai_conversations")
}

// ─────────────────────────────────────────────
// AI AGENT — MESSAGE (TRANSCRIPT)
// Each user turn and assistant response stored separately.
// toolsUsed tracks which tools fired for a given reply.
// ─────────────────────────────────────────────
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "user" | "assistant"
  content        String         @db.Text
  toolsUsed      String[]       // e.g. ["get_my_projects", "get_my_github"]
  createdAt      DateTime       @default(now())

  @@map("ai_messages")
}

// ─────────────────────────────────────────────
// AI AGENT — VOICE CONCURRENCY QUEUE
// Visitors who cannot get a voice slot immediately are
// added here. Prisma-backed for cross-instance consistency.
// promoted = true once the visitor was admitted.
// ─────────────────────────────────────────────
model AiQueue {
  id           String    @id @default(cuid())
  queueId      String    @unique // opaque UUID returned to browser
  ipHash       String
  joinedAt     DateTime  @default(now())
  lastPolledAt DateTime  @default(now())
  promoted     Boolean   @default(false)
  promotedAt   DateTime?

  @@map("ai_queue")
}

