# ──────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/portfolio?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.neon.tech/portfolio"

# ──────────────────────────────────────────────────────────────
# AUTH (Auth.js v5 + GitHub OAuth)
# ──────────────────────────────────────────────────────────────
AUTH_SECRET="REPLACE_WITH_32_RANDOM_BYTES"
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_APP_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_APP_CLIENT_SECRET"
ADMIN_EMAIL="Kishorehp134@gmail.com"

# ──────────────────────────────────────────────────────────────
# GITHUB API
# ──────────────────────────────────────────────────────────────
GITHUB_TOKEN="ghp_YOUR_FINE_GRAINED_PAT"
GITHUB_USERNAME="Kishoreabc"

# ──────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
CONTACT_FROM_EMAIL="contact@yourdomain.com"
CONTACT_TO_EMAIL="Kishorehp134@gmail.com"

# ──────────────────────────────────────────────────────────────
# CLOUDINARY
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="YOUR_UNSIGNED_PRESET_NAME"

# ──────────────────────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_LEETCODE_USERNAME="KISHORE-R"

# ──────────────────────────────────────────────────────────────
# AI AGENT — REQUIRED
# ──────────────────────────────────────────────────────────────
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSy..."

# Gemini Live WebSocket model (voice & chat assistant)
# Options: gemini-3.1-flash-live-preview, gemini-2.5-flash, gemini-2.0-flash-exp
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"

# Tavily web search (free tier, 1000 req/month): https://tavily.com
TAVILY_API_KEY="tvly-..."

# ──────────────────────────────────────────────────────────────
# AI AGENT — PROFILE LINKS
# ──────────────────────────────────────────────────────────────
PORTFOLIO_URL="https://yourdomain.com"
LINKEDIN_URL="https://www.linkedin.com/in/***/"
RESUME_URL=""  # Direct URL to resume PDF (optional — uses SiteConfig.resumeUrl if empty)

# ──────────────────────────────────────────────────────────────
# AI AGENT — SECURITY (optional, all have safe defaults)
# ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call /api/ai/* routes.
# Leave empty in development (allows all). Set in production.
AI_ALLOWED_ORIGINS="https://yourdomain.com"

# ──────────────────────────────────────────────────────────────
# AI AGENT — LIMITS (optional, all have safe defaults)
# ──────────────────────────────────────────────────────────────
AI_MAX_CONCURRENT_VOICE=2                 # Max simultaneous voice sessions
AI_MAX_VOICE_SESSION_SECONDS=600          # Voice session time limit (10 min)
AI_VOICE_WARNING_SECONDS=120              # Warn before session ends (2 min)
AI_MAX_CHAT_SESSION_SECONDS=1800          # Chat session idle timeout (30 min)
AI_MAX_MESSAGES_PER_SESSION=30            # Max messages per session
AI_MAX_TOOL_CALLS_PER_SESSION=20          # Max tool calls per session
AI_MAX_WEB_SEARCHES_PER_SESSION=5         # Max web searches per session
AI_MAX_SESSIONS_PER_IP_PER_DAY=10         # Max voice sessions per IP per day

# Daily global limits (Prisma-backed, shared across instances)
AI_DAILY_SESSION_LIMIT=100
AI_DAILY_MESSAGE_LIMIT=1000
AI_DAILY_SEARCH_LIMIT=100
AI_DAILY_GITHUB_LIMIT=500

# Feature toggles
AI_ENABLE_TAVILY_SEARCH=true
AI_ENABLE_GOOGLE_GROUNDING=true
